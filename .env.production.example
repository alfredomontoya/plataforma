# =============================================================================
# Galileo - plantilla de entorno para PRODUCCIÓN
# Copiar como .env en el servidor y completar los valores. No versionar el .env.
# =============================================================================

APP_NAME=Galileo
APP_ENV=production
APP_KEY=
# Si rotas la APP_KEY, conserva la anterior para descifrar datos existentes:
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
# Incluye el puerto si la app no se sirve en el estándar (443/80).
APP_URL=https://galileo.tu-dominio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base de datos dedicada (no usar root).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galileo
DB_USERNAME=galileo_app
DB_PASSWORD="CAMBIAR"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Requiere HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Si no hay trabajos en cola, sync evita depender de un worker.
# Si usas colas: database + php artisan queue:work bajo un servicio.
QUEUE_CONNECTION=sync

# Un solo servidor: file. Si hay Redis disponible: redis.
CACHE_STORE=file
CACHE_PREFIX=galileo

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.tu-dominio.com
MAIL_PORT=587
MAIL_USERNAME="CAMBIAR"
MAIL_PASSWORD="CAMBIAR"
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / CORS ---
SANCTUM_STATEFUL_DOMAINS=galileo.tu-dominio.com
CORS_ALLOWED_ORIGINS=https://galileo.tu-dominio.com
SANCTUM_TOKEN_EXPIRATION=480

# --- Opcional ---
# URL pública de assets si se sirven desde un CDN o subruta.
# ASSET_URL=https://cdn.tu-dominio.com
# Redis (si CACHE_STORE=redis):
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
