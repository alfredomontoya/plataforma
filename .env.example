APP_NAME=Galileo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# La interfaz está en español. Para que los mensajes de validación de Laravel
# también lo estén, instala las traducciones (laravel-lang) y usa APP_LOCALE=es.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=galileo
# DB_USERNAME=galileo
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En local (HTTP): false. En producción con HTTPS: true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=galileo

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Sanctum / CORS ---
# Dominios que pueden usar cookies de sesión SPA (Sanctum stateful).
SANCTUM_STATEFUL_DOMAINS=
# Orígenes permitidos para la API (por defecto toma APP_URL).
CORS_ALLOWED_ORIGINS="${APP_URL}"
# Minutos de vida de los tokens de API (480 = 8 h).
SANCTUM_TOKEN_EXPIRATION=480

# --- Opcional: Redis ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
